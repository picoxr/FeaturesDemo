--- !u!114 &1759643711
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1759643709}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Press this button

      to enable Mixed Reality'
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: Spanish
    Text: "Presiona este bot\xF3n\npara activar la Realidad Mixta."
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: French
    Text: "Appuyez sur ce bouton\npour activer la r\xE9alit\xE9 mixte"
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: German
    Text: "Dr\xFCcken Sie diese Taste,\num die Mixed Reality zu aktivieren"
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: Chinese
    Text: "\u6309\u4E0B\u6B64\u6309\u94AE\n\u4EE5\u542F\u7528\u6DF7\u5408\u73B0\u5B9E"
    Object: {fileID: 11400000, guid: b4089bd732b9b5a4fab44cc1643038ff, type: 2}
  - Language: Korean
    Text: "\uC774 \uBC84\uD2BC\uC744 \uB204\uB974\uC138\uC694\n\uD63C\uD569 \uD604\uC2E4\uC744
      \uD65C\uC131\uD654\uD558\uB824\uBA74"
    Object: {fileID: 11400000, guid: 77a199d47fc2c6b41b230a391b65941a, type: 2}
  - Language: Japanese
    Text: "\u3053\u306E\u30DC\u30BF\u30F3\u3092\u62BC\u3057\u3066\n\u8907\u5408\u73FE\u5B9F\u3092\u6709\u52B9\u306B\u3059\u308B"
    Object: {fileID: 11400000, guid: f3e08cf13c8d9124e9c791dc631c31f0, type: 2}
