  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: English
    Text: 'Put your controllers down

      to try out the Hand Tracking!'
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: Spanish
    Text: 'Retira los mandos

      para probar el seguimiento de manos.'
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: French
    Text: 'Posez vos manettes

      pour essayer le Hand Tracking !'
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: German
    Text: 'Legen Sie Ihre Controller ab

      um das Hand Tracking auszuprobieren!'
    Object: {fileID: 11400000, guid: c80ceb51b3238194fa0c7b9ca578f510, type: 2}
  - Language: Chinese
    Text: "\u653E\u4E0B\u4F60\u7684\u63A7\u5236\u5668\r\n\u6765\u5C1D\u8BD5\u4E00\u4E0B\u624B\u90E8\u8FFD\u8E2A"
    Object: {fileID: 11400000, guid: b4089bd732b9b5a4fab44cc1643038ff, type: 2}
  - Language: Korean
    Text: "\uCEE8\uD2B8\uB864\uB7EC\uB97C \uB0B4\uB824\uB193\uC73C\uC138\uC694\r\n\uC190
      \uCD94\uC801\uC744 \uC2DC\uB3C4\uD558\uB824\uBA74!"
    Object: {fileID: 11400000, guid: 77a199d47fc2c6b41b230a391b65941a, type: 2}
  - Language: Japanese
    Text: "\u30B3\u30F3\u30C8\u30ED\u30FC\u30E9\u30FC\u3092\u7F6E\u304F\r\n\u3067\u3001Hand
      Tracking\u3092\u8A66\u3059\u3053\u3068\u304C\u3067\u304D\u307E\u3059\uFF01"
    Object: {fileID: 11400000, guid: f3e08cf13c8d9124e9c791dc631c31f0, type: 2}
